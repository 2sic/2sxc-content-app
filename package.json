{
  "name": "app-content-templates",
  "version": "17.02.00",
  "description": "Bootstrap 5 based content templates for websites built with 2sxc and the 2sic bootstrap skin",
  "main": "(none)",
  "scripts": {
    "build-prod-bs5": "concurrently -n vite,tsc -c cyan,yellow \"npm run build-bs5\" \"npm run build:tsc\"",
    "build-bs5": "cross-env STYLE=bs5 vite build --watch",
    "build:tsc": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "author": "2sic internet solutions 2024",
  "license": "ISC",
  "devDependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@types/fancybox": "^3.5.7",
    "@types/jquery": "^4.0.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.22",
    "sass": "^1.101.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "bootstrap5": "npm:bootstrap@^5.3.8",
    "follow-redirects": "^1.16.0"
  }
}
